{
  "name":"apeiria-code","displayName":"Apeiria Code","description":"独立的第三方模型编码助手，支持 OpenAI 兼容 API 与 Google Vertex Gemini。","version":"0.1.0","publisher":"ayanami-local","private":true,"license":"MIT","type":"module",
  "engines":{"vscode":"^1.95.0","node":">=22.18.0"},"main":"./dist/extension.cjs","activationEvents":["onView:apeiriaCode.chat"],"categories":["AI","Other"],
  "contributes":{
    "viewsContainers":{"activitybar":[{"id":"apeiriaCode","title":"Apeiria Code","icon":"media/icon.svg"}]},
    "views":{"apeiriaCode":[{"type":"webview","id":"apeiriaCode.chat","name":"Apeiria Code","contextualTitle":"Apeiria Code"}]},
    "commands":[{"command":"apeiriaCode.open","title":"Apeiria Code：打开聊天"},{"command":"apeiriaCode.settings","title":"Apeiria Code：模型提供商","icon":"$(settings-gear)"},{"command":"apeiriaCode.newThread","title":"Apeiria Code：新建聊天","icon":"$(add)"},{"command":"apeiriaCode.attachSelection","title":"Apeiria Code：引用当前选区"},{"command":"apeiriaCode.openMcp","title":"Apeiria Code：管理 MCP"},{"command":"apeiriaCode.openSkills","title":"Apeiria Code：管理技能"},{"command":"apeiriaCode.restart","title":"Apeiria Code：重新连接内核"}],
    "menus":{"view/title":[{"command":"apeiriaCode.settings","when":"view == apeiriaCode.chat","group":"navigation"},{"command":"apeiriaCode.newThread","when":"view == apeiriaCode.chat","group":"navigation"}],"editor/context":[{"command":"apeiriaCode.attachSelection","when":"editorHasSelection","group":"apeiriaCode"}]},
    "configuration":{"title":"Apeiria Code","properties":{"apeiriaCode.permissions":{"type":"string","enum":["workspace-write","read-only"],"default":"workspace-write","description":"本扩展内核权限，工作区写入与按需审批。"}}}
  },
  "scripts":{"build":"node scripts/build.mjs","typecheck":"tsc --noEmit","test":"node --experimental-transform-types --test test/*.test.ts","package":"node --max-old-space-size=6144 scripts/package.mjs","bundle-engine":"node scripts/bundle-engine.mjs","preview":"node scripts/preview.mjs"},
  "dependencies":{"undici":"^7.16.0","https-proxy-agent":"^7.0.6","ws":"^8.18.3","vue":"^3.5.39"},
  "devDependencies":{"@types/node":"^22.18.0","@types/ws":"^8.18.1","@types/vscode":"^1.95.0","typescript":"^6.0.3","esbuild":"^0.25.0","fflate":"^0.8.2"}
}
